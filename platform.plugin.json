{
  "format": "neo.plugin/1",
  "id": "neo.platform",
  "version": 1,
  "collection": "depth",
  "kind": "native",
  "role": "platform",
  "entry": "neo_depth_provider",
  "requires": [
    "neo.services"
  ],
  "sources": [
    "provider.c"
  ],
  "targets": {
    "x86_64/Windows": {
      "sources": [
        "plugins/windows.c",
        "plugins/services_windows.c"
      ],
      "libraries": [
        "-ladvapi32",
        "-luserenv",
        "-lshell32",
        "-lws2_32",
        "-lbcrypt",
        "-lgdi32",
        "-lopengl32",
        "-lwinmm"
      ]
    },
    "x86_64/Linux": {
      "sources": [
        "plugins/linux.c",
        "plugins/services_linux.c"
      ],
      "libraries": [
        "-lseccomp",
        "-lX11",
        "-lGL",
        "-lasound",
        "-pthread"
      ]
    },
    "x86_64/x86_64": {
      "sources": [
        "plugins/x86_64/libc.c",
        "plugins/x86_64/boot.c",
        "plugins/x86_64/interrupts.c"
      ],
      "assembly": [
        "plugins/x86_64/entry.S"
      ],
      "embeds_image": [
        "plugins/x86_64/boot.c"
      ]
    }
  },
  "abi": 6,
  "includes": [
    "."
  ]
}
